# Copié en .env pour lancer le backend hors Docker. Aucun secret ici.
# En Docker, ces valeurs sont fournies par docker-compose.yml.

# SQLite par défaut ; PostgreSQL : postgresql+psycopg://user:pass@host:5432/db
AGENTSCOPE_DATABASE_URL=sqlite:///./agentscope.db

AGENTSCOPE_CORS_ORIGINS=http://localhost:5173

# Rétention des enregistrements bruts : "full" (défaut) ou "minimal"
# ("minimal" = index + sha256 seulement, payload gardé pour les rejets).
AGENTSCOPE_RAW_RECORD_RETENTION=full

# Fournisseur IA — "fake" n'appelle aucun service externe (tests, dev).
# Voir docs/ai/providers.md pour anthropic / openai / ollama.
AGENTSCOPE_LLM_PROVIDER=fake
AGENTSCOPE_LLM_MODEL=
AGENTSCOPE_LLM_BASE_URL=
AGENTSCOPE_LLM_API_KEY=
