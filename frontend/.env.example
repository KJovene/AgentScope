# Copy to `.env.development.local` (git-ignored, loaded by `vite dev`, NOT by vitest).
# The backend serves its API under /api/v1 (see backend/agentscope/interfaces/api/app.py).
# In dev, Vite proxies the "/api" prefix to the backend (see vite.config.ts), so the
# browser must call "/api/v1/...".
VITE_API_BASE_URL=/api/v1

# Dev-only: where Vite proxies "/api" (see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8000
