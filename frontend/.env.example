# Copied to .env.local — never commit real values. No secrets here (this bundle ships to the browser).
# Base URL of the AgentScope API. In dev, "/api" is proxied to the backend by Vite.
VITE_API_BASE_URL=/api

# Dev-only: where Vite proxies "/api" (see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8000
