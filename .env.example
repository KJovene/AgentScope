# docker compose — variables de la stack. `cp .env.example .env`. Aucun secret par défaut.

# --- Base de données ---
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=agentscope
POSTGRES_DB=agentscope
DB_PORT=5432

# --- Ports exposés sur l'hôte ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Ingestion ---
# Rétention des enregistrements bruts : "full" (défaut) ou "minimal".
AGENTSCOPE_RAW_RECORD_RETENTION=full

# --- IA interchangeable (voir docs/ai/) ---
# Trois valeurs possibles : fake | anthropic | openai.
# "fake" (défaut) = aucun appel externe, réponses déterministes.
# Ollama, LM Studio et OpenRouter exposent une API compatible OpenAI : utiliser
# AGENTSCOPE_LLM_PROVIDER=openai et pointer AGENTSCOPE_LLM_BASE_URL vers le serveur
# (depuis un conteneur : http://host.docker.internal:11434/v1). Il n'y a PAS de
# valeur "ollama".
AGENTSCOPE_LLM_PROVIDER=fake
AGENTSCOPE_LLM_MODEL=
AGENTSCOPE_LLM_BASE_URL=
# La clé est lue depuis l'environnement ; ne la committez jamais.
AGENTSCOPE_LLM_API_KEY=
