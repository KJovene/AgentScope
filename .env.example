# docker compose — variables de la stack. `cp .env.example .env`. Aucun secret par défaut.

# --- Base de données ---
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=agentscope
POSTGRES_DB=agentscope
DB_PORT=5432

# --- Ports exposés sur l'hôte ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- IA interchangeable (voir docs/ai/) ---
# "fake" = aucun appel externe. Sinon : anthropic | openai | ollama ...
AGENTSCOPE_LLM_PROVIDER=fake
AGENTSCOPE_LLM_MODEL=
AGENTSCOPE_LLM_BASE_URL=
# La clé est lue depuis l'environnement ; ne la committez jamais.
AGENTSCOPE_LLM_API_KEY=
